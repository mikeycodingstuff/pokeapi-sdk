{
    "name": "mikeycodingstuff/pokeapi-sdk",
    "description": "An SDK for the PokeApi created with the Saloon PHP library",
    "autoload": {
        "psr-4": {
            "PokeApiSdk\\": "src/"
        }
    },
    "authors": [
        {
            "name": "mikeycodingstuff",
            "email": "108337844+mikeycodingstuff@users.noreply.github.com"
        }
    ],
    "require": {
        "php": "^8.5.0",
        "saloonphp/saloon": "^4.0"
    },
    "require-dev": {
        "laravel/pint": "^1.32",
        "symfony/var-dumper": "^8.1",
        "pestphp/pest": "^3.8"
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    }
}
